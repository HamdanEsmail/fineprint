{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fineprint",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fineprint",
      "database_id": "307042e7-7267-42fd-91c4-4162cfff4280",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "STORE",
      "bucket_name": "fineprint"
    }
  ],
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "vars": {
    "PUBLIC_BASE_URL": "https://fineprint.hamdanesmail12-7a9.workers.dev"
  },
  "observability": {
    "enabled": true
  }
}
