{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fineprint",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fineprint",
      "database_id": "307042e7-7267-42fd-91c4-4162cfff4280",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "STORE",
      "bucket_name": "fineprint"
    }
  ],
  // The Worker itself: the hourly cron runs each overdue-check pull as its own invocation
  // (POST /api/admin/pull/:pageId), so every pull gets a request's CPU and subrequest budget.
  "services": [
    {
      "binding": "SELF",
      "service": "fineprint"
    }
  ],
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "vars": {
    "PUBLIC_BASE_URL": "https://fineprint.hamdanesmail12-7a9.workers.dev",
    // The site's screens (src/site) answer only when this is "1". Off, every site path answers as
    // the Worker did before the site existed. Previews upload with --var SITE_ENABLED:1.
    "SITE_ENABLED": "1",
    // The source repository the About screen links to. Empty, no link is shown.
    "REPO_URL": "",
    // Stored copies of the site's screens (src/site/htmlCache.ts): "0" serves every screen freshly
    // rendered. On: a new version or a watchlist change drops the copies it touches, and the hourly job
    // rebuilds home, About, the watchlist and the pages changed in the last day.
    "HTML_CACHE": "1"
  },
  // Styles, fonts, the favicon and robots.txt. A request that matches no file reaches the Worker.
  "assets": { "directory": "./public" },
  "preview_urls": true,
  "observability": {
    "enabled": true
  }
}
